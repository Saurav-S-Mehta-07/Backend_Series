<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Instagram</h1>
    <h2>@<%=data.name%></h2>
    <span>
        <button>Follower : <%=data.followers%></button>
        <button>Following : <%=data.following%></button>
    </span>
    <hr>
    <div class="posts">
        <%for(let post of data.posts){%>
            <div class="post">
               <img src="<%=post.image%>" alt="cat">
               <h3>likes: <%=post.likes%></h3>
               <h3>comments: <%=post.comments%></h3>
             </div>
        <%}%>
    </div>


    <script src="/app.js"></script>
</body>
</html>