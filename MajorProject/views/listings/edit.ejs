<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Explora</title>
</head>

<body>
  <h1>Edit Your Listing</h1>
  <form action="/listings/<%=listing._id%>?_method=put" method="POST">
    <input type="text" name="listing[title]" placeholder="enter title" value="<%=listing.title%>" required>
    <br /><br />
    <textarea name="listing[description]" placeholder="enter description" required><%=listing.description%> </textarea>
    <br /><br />
    <input type="text" name="listing[image]" placeholder="enter image url/link" value="<%=listing.image%>" required>
    <br />
    <br />
    <input type="number" name="listing[price]" placeholder="enter price" value="<%=listing.price%>" required>
    <br />
    <br />
    <input type="text" name="listing[location]" placeholder="enter loation" value="<%=listing.location%>" required>
    <br />
    <br />
    <input type="text" name="listing[country]" placeholder="enter country" value="<%=listing.country%>" required>
    <br />
    <br />
    <button>Edit</button>
  </form>

</body>

</html>