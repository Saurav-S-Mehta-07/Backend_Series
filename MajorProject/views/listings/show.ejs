 <% layout("/layouts/boilerplate.ejs")  %>

 <div class="row mt-3">

    <div class="col-8 offset-2">
        <h3><b><%=listing.title%></b></h3>
    </div>
    
    <div class="card col-8 offset-2 mb-3 listing-card">
       <img src="<%=listing.image%>" class="card-img-top show-img" alt="Listing-Image">
       <div class="card-body">
        
        <p class="card-text">
        </p>
        <p class="card-text"> <%= listing.description %> <br></p>
        <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %> </p>
        <p class="card-text"> <%= listing.location %></p>
        <p class="card-text"><%= listing.country %></p>

        <br><br>

          <div class="show-btns">
            <a href="/listings/<%= listing._id %>/edit" class="show-edit-btn mt-3">Edit</a>
            
            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE" class="show-btn-form">
              <button class="show-dlt-btn mt-2">Delete</button>
            </form>
          </div>

       </div>
    </div>

    <hr>
    
</div>
