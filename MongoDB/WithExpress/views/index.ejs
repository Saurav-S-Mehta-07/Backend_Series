<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Chats</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1 id="heading">WhatsApp</h1>
    <div class="add-new">
        <a href="/chats/new">+</a>
    </div>
    <div class="chats">
        <%for(chat of chats){%>
                <div class="chat">
                 <a href="/chats/<%=chat._id%>">
                 
                    <div>
                    <h2><span><%=chat.from.charAt(0)%></span> <i><%= chat.from%></i></h2>
                    <h2>To : <i><%=chat.to%></i></h2>
                    </div>
                    <h3>Message : <%=chat.msg%></h3>
                    <p><%=chat.created_at%></p>
                    <div class="extra=btns">
                        <a href="/chats/<%=chat._id%>/edit"><button class="edit-btn">🖊</button></a>
                        
                        <form action="/chats/<%=chat.id%>?_method=delete" method="post">
                            <button class="dlt-btn">🗑️</button>
                        </form>
                    </div>
                 </a>

                </div>
        <%}%>
    </div>
</body>
</html>