<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Chat</title>
    <style>
        .new-chat{
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        h1{
            color: green;
        }

        input, textarea{
            padding: 10px;
            border-radius: 10px;
            border: 1px solid black;
        }

        form{
            padding: 20px;
            border-radius: 20px;
            border: 2px solid black;
        }

        button{
            color: green;
            padding: 14px;
            border: 1px solid black;
            width: 100%;
            border-radius: 20px;
        }
    </style>
</head>
<body>
    <div class="new-chat">
        <h1>Create a New Chat</h1>
        <form action="/chats" method="post">
            <label for="from">Sender's Name : </label><br><br>
            <input type="text" id="from" placeholder="enter the sender's name" name="from">
            <br><br>
            <label for="to">Reciever's Name : </label><br>
            <br>
            <input type="text" id="to" placeholder="enter the reciever's name" name="to">
            <br><br>
            <label for="msg">Write Your Message here : </label><br><br>
            <textarea name="msg" id="msg" placeholder="enter your message..."></textarea>
            <br><br>
            <button type="submit">Add Chat</button>
        </form>
    </div>
</body>
</html>