<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quora</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <h1>Quora Posts</h1>
    <a href="/posts/new"> + Add New Post</a>
    <hr>
    <%for(let post of posts){%>
        <div>
            <h3>@<%=post.username%></h3>
            <p><%=post.content%></p>
        </div>
    <%}%>
</body>
</html>