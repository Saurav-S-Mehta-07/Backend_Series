<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <a href="/user/new" style="font-size: 2rem;">+ Add New User</a>
    <table border="true">
        <caption>Users Data</caption>
        <tr>
            <th>Id</th>
            <th>Username</th>
            <th>Email</th>
        </tr>

        <%for(let user of data){ %>
            <tr>
                <td><%=user.id%></td>
                <td><%=user.username%></td>
                <td><%=user.email%></td>
                <td>
                    <form action="/user/<%=user.id%>/edit" method="get">
                        <button>Edit</button>
                    </form>
                </td>
                <td>
                    <form action="/user/<%=user.id%>/?_method=delete" method="post">
                        <button>Delete</button>
                    </form>
                </td>
            </tr>
        <%}%>
    </table>
</body>
</html>